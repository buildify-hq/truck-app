{
  "expo": {
    "name": "ट्रक हिशोब",
    "slug": "truck-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.truckapp123.truckapp",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ॲपला बिलाचे फोटो काढण्यासाठी गॅलरी आणि कॅमेऱ्याची परवानगी हवी आहे."
        }
      ],
      "expo-notifications"
    ]
  }
}
