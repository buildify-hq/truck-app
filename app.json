{
  "expo": {
    "name": "truck-app",
    "slug": "truck-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.truckapp123.truckapp",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to attach bills to entries."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ddf66d9b-4755-4e41-8f91-76fc3a4395a5"
      }
    }
  }
}
